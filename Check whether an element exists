
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Set<Integer> set = new HashSet<>();

        set.add(10);
        set.add(20);
        set.add(30);

        int search = 20;

        if (set.contains(search)) {
            System.out.println("Element found");
        } else {
            System.out.println("Element not found");
        }
    }
}
