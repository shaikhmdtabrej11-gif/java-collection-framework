
import java.util.Arrays;

public class Main {

    public static <T> void swap(T[] arr, int i, int j) {
        T temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
    }

    public static void main(String[] args) {
        Integer[] arr = {10, 20, 30, 40};

        swap(arr, 0, 3);

        System.out.println(Arrays.toString(arr));
    }
}
