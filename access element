import java.util.*;

public class Main {
    public static void main(String[] args) {

        Collection<Integer> c1 = new ArrayList<>(
            Arrays.asList(10, 20, 30, 40)
        );

        Collection<Integer> c2 = new ArrayList<>(
            Arrays.asList(30, 40, 50, 60)
        );

        Collection<Integer> c3 = new ArrayList<>(c1);
        c3.addAll(c2);
        System.out.println("addAll: " + c3);

        c3 = new ArrayList<>(c1);
        c3.removeAll(c2);
        System.out.println("removeAll: " + c3);

        c3 = new ArrayList<>(c1);
        c3.retainAll(c2);
        System.out.println("retainAll: " + c3);
    }
}
