
import java.util.*;

public class Main {

    static double sum(List<? extends Number> list) {
        double total = 0;

        for (Number n : list) {
            total += n.doubleValue();
        }

        return total;
    }

    public static void main(String[] args) {
        List<Integer> a = Arrays.asList(10, 20, 30);
        List<Double> b = Arrays.asList(1.5, 2.5);

        System.out.println(sum(a));
        System.out.println(sum(b));
    }
}
