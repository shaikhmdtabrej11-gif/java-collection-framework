
class Pair<K, V> {
    K key;
    V value;

    Pair(K key, V value) {
        this.key = key;
        this.value = value;
    }

    void display() {
        System.out.println(key + " = " + value);
    }
}

public class Main {
    public static void main(String[] args) {
        Pair<String, Integer> p1 =
                new Pair<>("Age", 18);

        Pair<String, String> p2 =
                new Pair<>("Language", "Java");

        p1.display();
        p2.display();
    }
}
